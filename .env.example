# Base de datos (PostgreSQL de Vercel: Neon o Prisma Postgres)
# DATABASE_URL: la que usa la API (puede ser la "pooled" de Neon o la prisma+postgres:// de Prisma Postgres).
# DIRECT_URL: conexion directa (sin pooler). La usan las migraciones, el seed y la sincronizacion con SEPA.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT (secretos largos y distintos entre si)
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# CORS: URL(s) del front que pueden consultar la API desde el navegador (separadas por coma, sin barra final).
# Si no se define, solo se permite http://localhost:4200. En Vercel incluir la URL del demo.
FRONTEND_URL="http://localhost:4200"

# Demo (benqui-go-demo): el front canjea esta clave por un token temporal en POST /api/demo/session.
# Sin DEMO_ACCESS_KEY el demo queda deshabilitado (503). Cambiarla invalida la clave vieja al instante;
# los tokens ya emitidos duran hasta DEMO_TOKEN_EXPIRES_IN.
DEMO_ACCESS_KEY=""
DEMO_TOKEN_EXPIRES_IN="2h"
DEMO_PRODUCTS_PER_CATEGORY=10

# Swagger (/api/docs): en produccion (NODE_ENV=production) requiere usuario y clave; si no se definen, queda deshabilitado.
SWAGGER_USER=""
SWAGGER_PASSWORD=""

# Sincronizacion con SEPA (scripts/sync-catalog.ts)
# Minimo de sucursales que tienen que informar un producto para que entre al catalogo.
SYNC_MIN_STORES=3
# Para pruebas: reusar un ZIP ya descargado en vez de bajarlo (~330 MB).
# SEPA_ZIP_PATH="C:/ruta/sepa.zip"

# Usuario administrador inicial (seed)
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="CambiarEsto123!"
